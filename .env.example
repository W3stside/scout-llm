# Copy to .env and fill in. .env is gitignored — never commit a bot token.

# --- Telegram ---------------------------------------------------------------------
# From @BotFather. Treat as a password: anyone holding it can send as your bot.
TELEGRAM_BOT_TOKEN=

# Your numeric chat id — get it by messaging @userinfobot.
# Scout serves this chat and silently ignores every other sender, so a leaked token
# cannot be used to make Scout scrape on someone else's behalf.
TELEGRAM_CHAT_ID=

# --- Model ------------------------------------------------------------------------
# The host's Ollama. Inside the dev container this resolves via the host-gateway entry
# that init-firewall.sh opens; from compose, via the extra_hosts mapping.
OLLAMA_URL=http://host.docker.internal:11434

# Baked by scripts/bake-model.sh from models/Modelfile.scout.
SCOUT_MODEL=scout

# Generous because a cold load of a 17.7GB model can take ~30s before the first token.
OLLAMA_TIMEOUT_MS=300000

# --- Politeness -------------------------------------------------------------------
# Minimum gap between requests to the same host, independent of schedule. Jitter is
# added on top. Lowering this is the fastest route to an IP ban.
MIN_HOST_INTERVAL_MS=3000

# Set to false only deliberately, and only for a site you have reason to believe
# permits it. Automated scraping is generally contrary to classifieds' terms of
# service; this flag exists so ignoring robots.txt is always an explicit choice.
RESPECT_ROBOTS=true

# --- Paths / logging --------------------------------------------------------------
DATA_DIR=./data
TARGETS_DIR=./targets
RECIPES_DIR=./recipes
LOG_LEVEL=info
