# The scraper service — the untrusted tier.
#
# This container reaches arbitrary third-party sites and parses whatever they return, so it
# is built to hold nothing worth stealing: no ~/.claude, no ~/.npmrc, no SSH keys, no docker
# socket. That emptiness is precisely what earns it open egress, while the dev container
# keeps its strict allowlist because it holds all of those things.
#
# Built FROM the official Playwright image rather than installing Chromium by hand: it pins
# the browser build to the Playwright version, which is the pairing that actually breaks
# when they drift.

FROM mcr.microsoft.com/playwright:v1.62.1-noble AS build

WORKDIR /app

# better-sqlite3 is a native addon. The Playwright image ships Node but no toolchain, and
# its Node is new enough that better-sqlite3 has no prebuilt binary for it — so
# node-gyp falls back to compiling from source and dies with "not found: make".
#
# Build tools live in THIS stage only; the runtime stage copies the compiled result, so a
# compiler never ships in the image that parses hostile input.
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ \
    && rm -rf /var/lib/apt/lists/*

# Dependencies first, so a source edit does not re-run the native rebuild.
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile

COPY tsconfig.json ./
COPY src ./src
RUN yarn build

# Drop dev dependencies in place, keeping the already-compiled better-sqlite3 binding.
# Compiling once and pruning beats installing twice: the runtime stage has no toolchain,
# so a second `yarn install` there would fail exactly as the first one did.
RUN yarn install --frozen-lockfile --production && yarn cache clean


FROM mcr.microsoft.com/playwright:v1.62.1-noble AS runtime

WORKDIR /app
ENV NODE_ENV=production

# Both stages share a base image, so the Node ABI matches and the compiled addon is valid.
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/dist ./dist
COPY package.json ./

# The base image ships a non-root `pwuser`. Running as root here would mean a Chromium
# renderer escape lands as root, which is the one outcome the whole two-tier split exists
# to prevent.
RUN mkdir -p /app/data && chown -R pwuser:pwuser /app
USER pwuser

# Playwright writes its browser profile under HOME; with a read-only rootfs this must point
# at a writable mount or every browser fallback fails.
ENV HOME=/tmp

CMD ["node", "--disable-warning=ExperimentalWarning", "dist/index.js"]
